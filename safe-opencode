#!/usr/bin/env bash
set -euo pipefail

MODE="ro"
RESUME=""
PROJECT=""
PYTHON_ENV=""
CONFIG="${SAFE_OPENCODE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"
DATA="${SAFE_OPENCODE_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode}"
BWRAP="${SAFE_OPENCODE_BWRAP:-bwrap}"
CHECK_SERVICE=1
#Exposed host paths to mount in the sandbox
RO_PATHS=()
RW_PATHS=()
#Target mount points in the sandbox
RO_TARGETS=()
RW_TARGETS=()
EXTRA_PATHS=()
LIBRARY_PATHS=()
DRY_RUN=0

usage() {
    cat <<'EOF'
Usage:
  safe-opencode [OPTIONS] [PROJECT_DIR] [-- OPENCODE_ARGS...]

Options:
  --rw                    Mount the project read/write (default: read-only)
  --mount-ro HOST_PATH[=SANDBOX_PATH] Add a read-only host directory at SANDBOX_PATH (default: /mnt/host-ro/N)
  --mount-rw HOST_PATH[=SANDBOX_PATH] Add a read/write host directory at SANDBOX_PATH (default: /mnt/host-rw/N)
  --path PATH             Prepend a sandbox directory to PATH
  --library-path PATH     Prepend a sandbox directory to LD_LIBRARY_PATH
  --python-env PATH       Expose a Python environment read-only
  --config-dir PATH       Use a different host OpenCode config directory
  --data-dir PATH         Use a different host OpenCode data directory
  --bwrap PATH            Use a specific Bubblewrap executable
  --no-service-check      Skip the OpenCode service status check
  --resume                Continue the most recent session
  --resume ID             Resume a specific session
  --dry-run               Open an interactive shell in the sandbox without starting OpenCode
  --help, -h              Show this help

Mount sources must be existing directories. Without DEST, mounts use numbered
paths under /mnt/host-ro or /mnt/host-rw. DEST must be an absolute sandbox
directory other than /. Named destinations cannot replace built-in sandbox
mounts. Do not mount / or other broad, sensitive directories.
Note that --standalone provides isolation of the server, opencode creates a new session, and the sandbox is destroyed when the session ends.
Without --standalone, if there is running OpenCode service, the sandbox will connect to it and use its session which may not be isolated from the host. Use --standalone to ensure isolation.

Examples:
  safe-opencode . -- --standalone
  safe-opencode --rw . -- --standalone
  safe-opencode --mount-ro /data/reference --mount-rw /data/output . -- --standalone
  safe-opencode --mount-ro /opt/vendor/lib=/opt/vendor/lib --library-path /opt/vendor/lib . -- --standalone
  safe-opencode --python-env "$HOME/.venvs/project" --rw . -- --standalone
  safe-opencode --rw . -- --help
EOF
}

read_mount_spec() {
    local spec="$1"
    MOUNT_SOURCE="$spec"
    MOUNT_TARGET=""

    if [[ "$spec" == *=* ]]; then
        MOUNT_SOURCE="${spec%%=*}"
        MOUNT_TARGET="${spec#*=}"

        if [[ -z "$MOUNT_SOURCE" || -z "$MOUNT_TARGET" || "$MOUNT_TARGET" != /* ]]; then
            echo "Error: named mount must be HOST_PATH=/absolute/sandbox/path: $spec" >&2
            exit 2
        fi
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --rw)
            MODE="rw"
            shift
            ;;
        --mount-ro|--mount-rw|--python-env|--config-dir|--data-dir|--bwrap|--path|--library-path)
            option="$1"
            [[ $# -ge 2 && -n "$2" ]] || {
                echo "Error: $option requires a path" >&2
                exit 2
            }
            case "$option" in
                --mount-ro)
                    read_mount_spec "$2"
                    RO_PATHS+=("$MOUNT_SOURCE")
                    RO_TARGETS+=("$MOUNT_TARGET")
                    ;;
                --mount-rw)
                    read_mount_spec "$2"
                    RW_PATHS+=("$MOUNT_SOURCE")
                    RW_TARGETS+=("$MOUNT_TARGET")
                    ;;
                --python-env) PYTHON_ENV="$2" ;;
                --config-dir) CONFIG="$2" ;;
                --data-dir) DATA="$2" ;;
                --bwrap) BWRAP="$2" ;;
                --path) EXTRA_PATHS+=("$2") ;;
                --library-path) LIBRARY_PATHS+=("$2") ;;
            esac
            shift 2
            ;;
        --no-service-check)
            CHECK_SERVICE=0
            shift
            ;;
        --resume)
            if [[ $# -ge 2 && "$2" != -* ]]; then
                RESUME="$2"
                shift 2
            else
                RESUME="latest"
                shift
            fi
            ;;
	--dry-run)
	    DRY_RUN=1
	    shift
	    ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            PROJECT="$1"
            shift
            break
            ;;
    esac
done

# Remove the separator after PROJECT_DIR before forwarding OpenCode arguments.
if [[ "${1:-}" == "--" ]]; then
    shift
fi

PROJECT="$(realpath -e "${PROJECT:-.}")"
if [[ ! -d "$PROJECT" || "$PROJECT" == "/" ]]; then
    echo "Error: project must be a directory other than /: $PROJECT" >&2
    exit 1
fi

for i in "${!RO_PATHS[@]}"; do
    RO_PATHS[$i]="$(realpath -e "${RO_PATHS[$i]}")"
    if [[ ! -d "${RO_PATHS[$i]}" || "${RO_PATHS[$i]}" == "/" ]]; then
        echo "Error: read-only mount must be a directory other than /: ${RO_PATHS[$i]}" >&2
        exit 1
    fi
    if [[ -n "${RO_TARGETS[$i]}" ]]; then
        RO_TARGETS[$i]="$(realpath -m "${RO_TARGETS[$i]}")"
    fi
done

for i in "${!RW_PATHS[@]}"; do
    RW_PATHS[$i]="$(realpath -e "${RW_PATHS[$i]}")"
    if [[ ! -d "${RW_PATHS[$i]}" || "${RW_PATHS[$i]}" == "/" ]]; then
        echo "Error: read/write mount must be a directory other than /: ${RW_PATHS[$i]}" >&2
        exit 1
    fi
    if [[ -n "${RW_TARGETS[$i]}" ]]; then
        RW_TARGETS[$i]="$(realpath -m "${RW_TARGETS[$i]}")"
    fi
done

RESERVED_MOUNTS=(/usr /bin /lib /lib64 /etc/hosts /etc/resolv.conf /etc/nsswitch.conf /etc/pki /etc/ssl /tmp /dev /proc /workspace /sandbox-config /sandbox-data /opt/opencode-bin /mnt/host-ro /mnt/host-rw)
NAMED_TARGETS=()
for target in "${RO_TARGETS[@]}" "${RW_TARGETS[@]}"; do
    [[ -n "$target" ]] || continue
    if [[ "$target" == "/" ]]; then
        echo "Error: named mount destination must not be /" >&2
        exit 1
    fi
    for reserved in "${RESERVED_MOUNTS[@]}"; do
        if [[ "$target" == "$reserved" || "$target" == "$reserved/"* || "$reserved" == "$target/"* ]]; then
            printf 'Error: named mount destination conflicts with built-in sandbox path %s: %s\n' "$reserved" "$target" >&2
            exit 1
        fi
    done
    for existing in "${NAMED_TARGETS[@]}"; do
        if [[ "$target" == "$existing" ]]; then
            printf 'Error: duplicate named mount destination: %s\n' "$target" >&2
            exit 1
        fi
    done
    NAMED_TARGETS+=("$target")
done

for path in "${EXTRA_PATHS[@]}" "${LIBRARY_PATHS[@]}"; do
    if [[ "$path" != /* || "$path" == *:* ]]; then
        printf 'Error: PATH entries must be absolute sandbox paths without colons: %s\n' "$path" >&2
        exit 2
    fi
done

if [[ -n "$PYTHON_ENV" ]]; then
    PYTHON_ENV="$(realpath -e "$PYTHON_ENV")"
    if [[ ! -d "$PYTHON_ENV" || ! -x "$PYTHON_ENV/bin/python" ]]; then
        echo "Error: Python environment must contain an executable bin/python: $PYTHON_ENV" >&2
        exit 1
    fi
fi

OPENCODE="$(command -v opencode || true)"
if [[ -z "$OPENCODE" ]]; then
    echo "Error: opencode not found in PATH" >&2
    exit 1
fi
OPENCODE="$(readlink -f "$OPENCODE")"
OPENCODE_DIR="$(dirname "$OPENCODE")"
OPENCODE_NAME="$(basename "$OPENCODE")"

if ! command -v "$BWRAP" >/dev/null 2>&1; then
    echo "Error: Bubblewrap executable not found: $BWRAP" >&2
    exit 1
fi
BWRAP="$(command -v "$BWRAP")"

CONFIG="$(realpath -m "$CONFIG")"
DATA="$(realpath -m "$DATA")"
mkdir -p "$CONFIG" "$DATA"

if [[ "$CHECK_SERVICE" == 1 && "$DRY_RUN" == 0 ]]; then
    if SERVICE_STATUS="$("$OPENCODE" service status 2>&1)"; then
        printf 'OpenCode service status: %s\n' "${SERVICE_STATUS:-available}"
        if [[ "$SERVICE_STATUS" != "stopped" ]]; then
            printf 'An OpenCode background service is running outside the sandbox. Stop it before continuing? [y/N] ' >&2
            if ! IFS= read -r reply || [[ ! "$reply" =~ ^[Yy]([Ee][Ss])?$ ]]; then
                echo "Aborted: the host OpenCode service was not stopped." >&2
                exit 1
            fi
            if ! "$OPENCODE" service stop; then
                echo "Error: failed to stop the host OpenCode service." >&2
                exit 1
            fi
            if ! SERVICE_STATUS="$("$OPENCODE" service status 2>&1)"; then
                printf 'Error: could not verify the host OpenCode service stopped: %s\n' "$SERVICE_STATUS" >&2
                exit 1
            fi
            if [[ "$SERVICE_STATUS" != "stopped" ]]; then
                printf 'Error: host OpenCode service is not stopped: %s\n' "$SERVICE_STATUS" >&2
                exit 1
            fi
        fi
    else
        printf 'OpenCode service status unavailable: %s\n' "${SERVICE_STATUS:-no status returned}" >&2
    fi
fi

ARGS=(
    --die-with-parent
    --new-session
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --dir /tmp/home
    --dir /tmp/cache
    --dir /etc
)

for d in /lib /lib64; do
    if [[ -e "$d" ]]; then
        ARGS+=(--ro-bind "$d" "$d")
    fi
done

for f in /etc/hosts /etc/resolv.conf /etc/nsswitch.conf; do
    if [[ -e "$f" ]]; then
        ARGS+=(--ro-bind "$(readlink -f "$f")" "$f")
    fi
done

for d in /etc/pki /etc/ssl; do
    if [[ -d "$d" ]]; then
        ARGS+=(--ro-bind "$d" "$d")
    fi
done

ARGS+=(--dir /workspace)
if [[ "$MODE" == "rw" ]]; then
    ARGS+=(--bind "$PROJECT" /workspace)
else
    ARGS+=(--ro-bind "$PROJECT" /workspace)
fi
# For read/write:

ARGS+=(
    --dir /sandbox-config
    --bind "$CONFIG" /sandbox-config/opencode
    --dir /sandbox-data
    --bind "$DATA" /sandbox-data/opencode
    --dir /opt
    --ro-bind "$OPENCODE_DIR" /opt/opencode-bin
    --dir /mnt
    --dir /mnt/host-ro
    --dir /mnt/host-rw
)
DIRS_ADDED=(/tmp /tmp/home /tmp/cache /etc /workspace /sandbox-config /sandbox-data /opt /mnt /mnt/host-ro /mnt/host-rw)

ensure_parent_dirs() {
    local path="$1"
    local parent
    local component
    local known
    local current=""
    local -a components=()

    parent="$(dirname "$path")"
    IFS='/' read -r -a components <<< "$parent"
    for component in "${components[@]}"; do
        [[ -n "$component" ]] || continue
        current+="/$component"
        for known in "${DIRS_ADDED[@]}"; do
            [[ "$current" == "$known" ]] && continue 2
        done
        ARGS+=(--dir "$current")
        DIRS_ADDED+=("$current")
    done
}

for i in "${!RO_PATHS[@]}"; do
    target="${RO_TARGETS[$i]}"
    if [[ -z "$target" ]]; then
        target="/mnt/host-ro/$((i + 1))"
    else
        ensure_parent_dirs "$target"
    fi
    ARGS+=(--dir "$target" --ro-bind "${RO_PATHS[$i]}" "$target")
    DIRS_ADDED+=("$target")
done

for i in "${!RW_PATHS[@]}"; do
    target="${RW_TARGETS[$i]}"
    if [[ -z "$target" ]]; then
        target="/mnt/host-rw/$((i + 1))"
    else
        ensure_parent_dirs "$target"
    fi
    ARGS+=(--dir "$target" --bind "${RW_PATHS[$i]}" "$target")
    DIRS_ADDED+=("$target")
done

PATH_VALUE="/opt/opencode-bin:/usr/local/bin:/usr/bin:/bin"
EXTRA_PATH_VALUE=""
for path in "${EXTRA_PATHS[@]}"; do
    EXTRA_PATH_VALUE="${EXTRA_PATH_VALUE:+$EXTRA_PATH_VALUE:}$path"
done
if [[ -n "$EXTRA_PATH_VALUE" ]]; then
    PATH_VALUE="$EXTRA_PATH_VALUE:$PATH_VALUE"
fi
if [[ -n "$PYTHON_ENV" ]]; then
    ensure_parent_dirs "$PYTHON_ENV"
    ARGS+=(--ro-bind "$PYTHON_ENV" "$PYTHON_ENV")
    PATH_VALUE="$PYTHON_ENV/bin:$PATH_VALUE"
    ARGS+=(--setenv VIRTUAL_ENV "$PYTHON_ENV")
fi

if [[ "${#LIBRARY_PATHS[@]}" -gt 0 ]]; then
    LIBRARY_PATH_VALUE=""
    for path in "${LIBRARY_PATHS[@]}"; do
        LIBRARY_PATH_VALUE="${LIBRARY_PATH_VALUE:+$LIBRARY_PATH_VALUE:}$path"
    done
    ARGS+=(--setenv LD_LIBRARY_PATH "$LIBRARY_PATH_VALUE")
fi

ARGS+=(
    --setenv HOME /tmp/home
    --setenv XDG_CONFIG_HOME /sandbox-config
    --setenv XDG_DATA_HOME /sandbox-data
    --setenv XDG_CACHE_HOME /tmp/cache
    --setenv TMPDIR /tmp
    --setenv PATH "$PATH_VALUE"
    --chdir /workspace
)

OC_ARGS=()
if [[ "$RESUME" == "latest" ]]; then
    OC_ARGS+=(--continue)
elif [[ -n "$RESUME" ]]; then
    OC_ARGS+=(--session "$RESUME")
fi
OC_ARGS+=("$@")

STANDALONE=0
for arg in "${OC_ARGS[@]}"; do
    if [[ "$arg" == "--standalone" ]]; then
        STANDALONE=1
        break
    fi
done
if [[ "$STANDALONE" == 0 && "$DRY_RUN" == 0 ]]; then
    cat >&2 <<'EOF'
WARNING: OpenCode is not being started with --standalone.
It may connect to or start a background service outside this sandbox, which can
bypass Bubblewrap filesystem isolation. Add "-- --standalone" to keep the
OpenCode server inside the sandbox.
EOF
fi

echo "Project: $PROJECT ($MODE)"
for i in "${!RO_PATHS[@]}"; do
    target="${RO_TARGETS[$i]:-/mnt/host-ro/$((i + 1))}"
    printf 'Read-only mount: %s -> %s\n' "${RO_PATHS[$i]}" "$target"
done
for i in "${!RW_PATHS[@]}"; do
    target="${RW_TARGETS[$i]:-/mnt/host-rw/$((i + 1))}"
    printf 'Read/write mount: %s -> %s\n' "${RW_PATHS[$i]}" "$target"
done
for path in "${EXTRA_PATHS[@]}"; do
    printf 'PATH entry: %s\n' "$path"
done
for path in "${LIBRARY_PATHS[@]}"; do
    printf 'Library path: %s\n' "$path"
done
if [[ -n "$PYTHON_ENV" ]]; then
    echo "Python environment: $PYTHON_ENV (read-only)"
fi
echo "Resume: ${RESUME:-new session}"

print_prompt_context() {
    printf 'Sandbox start time: %s\n' "$(date --iso-8601=seconds)"
    echo "Use only the files and paths available in this sandbox. The project is /workspace ($MODE)."

    for i in "${!RO_PATHS[@]}"; do
        target="${RO_TARGETS[$i]:-/mnt/host-ro/$((i + 1))}"
        echo "Host reference directory $target is read-only."
    done

    for i in "${!RW_PATHS[@]}"; do
        target="${RW_TARGETS[$i]:-/mnt/host-rw/$((i + 1))}"
        echo "Host output directory $target is writable; keep changes there unless asked otherwise."
    done

    if [[ -n "$PYTHON_ENV" ]]; then
        echo "Python is available from the read-only environment at $PYTHON_ENV/bin/python."
    fi

    for path in "${EXTRA_PATHS[@]}"; do
        echo "Executable directory available at $path."
    done

    for path in "${LIBRARY_PATHS[@]}"; do
        echo "Shared libraries are available from $path."
    done
}

if [[ "$DRY_RUN" == 1 ]]; then
    echo "Environment context:"
    print_prompt_context
else
    echo "Environment context to be passed to OpenCode, saved to $PROJECT/PROMPT_CONTEXT:"
    PROMPT_CONTEXT="$PROJECT/PROMPT_CONTEXT"
    print_prompt_context | tee "$PROMPT_CONTEXT"
fi


if [[ "$DRY_RUN" == 1 ]]; then
    echo "Dry run: starting an interactive shell in the sandbox without starting OpenCode."
    exec "$BWRAP" "${ARGS[@]}" /bin/bash --noprofile --norc -i
else
    echo "Starting OpenCode in the sandbox..."
	exec "$BWRAP" "${ARGS[@]}" \
    	"/opt/opencode-bin/$OPENCODE_NAME" \
    	"${OC_ARGS[@]}"
fi
